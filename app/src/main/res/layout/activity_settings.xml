<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView style="@style/SettingsHeader" android:text="Medication times" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="Tap a time to change it. Eating windows are worked out automatically from these." />
        <LinearLayout
            android:id="@+id/doseTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button
            android:id="@+id/btnAddDose"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:text="+ Add a dose time" />

        <TextView style="@style/SettingsHeader" android:text="Today's doses" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="Cleared an alarm by mistake? Tap the dose to make it pending again — the alarm will ring straight away if it is due, or at its time." />
        <LinearLayout
            android:id="@+id/todayDoses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView style="@style/SettingsHeader" android:text="Meal reminders" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="A bugle call at each meal time, repeated every few minutes until Eating now is tapped (or a meal is logged). It only sounds while eating is actually allowed, and stops for the day once the eating window has closed." />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="Meal reminders on" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mealsEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/mealTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnAddMeal"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="+ Add a meal" />
            <Button
                android:id="@+id/btnTestMeal"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:text="Play sound" />
        </LinearLayout>
        <TextView
            android:id="@+id/mealSoundInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="Sound: bugle call (built in)" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnPickMealSound"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Choose a different sound" />
            <Button
                android:id="@+id/btnBugle"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Back to bugle" />
        </LinearLayout>

        <TextView style="@style/SettingsHeader" android:text="Eating rules" />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="Minutes after a dose before eating" />
            <EditText android:id="@+id/eatAfter" style="@style/SettingsNumber" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="Minutes food-free before the next dose" />
            <EditText android:id="@+id/eatBefore" style="@style/SettingsNumber" />
        </LinearLayout>

        <TextView style="@style/SettingsHeader" android:text="Alarm" />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="Ring again after (minutes) — until the code is scanned" />
            <EditText android:id="@+id/snooze" style="@style/SettingsNumber" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="The alarm rings without stopping until a button is pressed or the code is scanned." />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnTestAlarm"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Test alarm (15 s)" />
            <Button
                android:id="@+id/btnCancelTest"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:text="Cancel test alarm" />
        </LinearLayout>

        <TextView style="@style/SettingsHeader" android:text="Volume" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="The alarm starts quiet and gets louder, so it does not startle him nearby but still reaches another room. The phone\'s own alarm volume is the ceiling." />
        <TextView
            android:id="@+id/volLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="17sp"
            android:text="Loudest: 100%" />
        <SeekBar
            android:id="@+id/volSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="10"
            android:max="100"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="Start at (% of that)" />
            <EditText android:id="@+id/volStart" style="@style/SettingsNumber" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="Reach full volume after (minutes)" />
            <EditText android:id="@+id/volRamp" style="@style/SettingsNumber" />
        </LinearLayout>
        <Button
            android:id="@+id/btnVolSample"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:text="Hear quiet start, then full" />

        <TextView style="@style/SettingsHeader" android:text="Carer PIN" />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="PIN (4–8 digits)" />
            <EditText
                android:id="@+id/pin"
                style="@style/SettingsNumber"
                android:inputType="numberPassword"
                android:hint="unchanged" />
        </LinearLayout>

        <TextView style="@style/SettingsHeader" android:text="QR code" />
        <TextView
            android:id="@+id/qrInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="" />
        <Button
            android:id="@+id/btnNewQr"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:text="Generate a new QR code (old one stops working)" />
        <Button
            android:id="@+id/btnAdoptQr"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false"
            android:text="Use a code I already printed (scan it)" />

        <TextView style="@style/SettingsHeader" android:text="Carer alerts" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:text="Sends a push notification to the carer's phone if a dose is still unconfirmed after the delay below. Install the free ntfy app on the carer's phone and subscribe to the topic shown." />
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="Alerts on" />
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/alertsEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout style="@style/SettingsRow">
            <TextView style="@style/SettingsLabel" android:text="Alert after (minutes past due)" />
            <EditText android:id="@+id/alertAfter" style="@style/SettingsNumber" />
        </LinearLayout>
        <TextView
            android:id="@+id/alertTopic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:text="" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnShareTopic"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="Share topic link" />
            <Button
                android:id="@+id/btnTestAlert"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:text="Send test alert" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save" />
    </LinearLayout>
</ScrollView>
