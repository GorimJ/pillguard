<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/setupBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/warn_amber_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/setupText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/warn_amber"
                android:textSize="17sp"
                android:text="Setup needed" />
            <Button
                android:id="@+id/btnSetup"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAllCaps="false"
                android:text="Fix" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/eatCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/ok_green_bg"
            android:padding="20dp">
            <TextView
                android:id="@+id/eatHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ok_green"
                android:textSize="30sp"
                android:textStyle="bold"
                android:text="OK to eat" />
            <TextView
                android:id="@+id/eatDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/black"
                android:textSize="19sp"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/nextDose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:text="Next dose: 10:30" />

        <Button
            android:id="@+id/btnAte"
            style="@style/BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/i_ate" />

        <Button
            android:id="@+id/btnScanNow"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="64dp"
            android:textSize="20sp"
            android:textAllCaps="false"
            android:text="Scan QR — taking a dose now" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Today" />

        <LinearLayout
            android:id="@+id/doseList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnHistory"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:text="@string/history" />
            <Button
                android:id="@+id/btnQr"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:text="QR code" />
            <Button
                android:id="@+id/btnSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
