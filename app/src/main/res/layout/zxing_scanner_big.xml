<?xml version="1.0" encoding="utf-8"?>
<!-- Inner layout for DecoratedBarcodeView: camera preview, viewfinder overlay, big prompt text. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_framing_rect_width="320dp"
        app:zxing_framing_rect_height="320dp" />

    <com.journeyapps.barcodescanner.ViewfinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_possible_result_points="@color/zxing_viewfinder_laser"
        app:zxing_result_view="@color/black"
        app:zxing_viewfinder_laser="@color/zxing_viewfinder_laser"
        app:zxing_viewfinder_mask="@color/zxing_viewfinder_mask" />

    <TextView
        android:id="@+id/zxing_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="#CC000000"
        android:padding="16dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:gravity="center"
        android:text="Point the square at the QR code" />
</merge>
