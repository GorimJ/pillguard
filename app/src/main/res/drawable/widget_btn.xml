<?xml version="1.0" encoding="utf-8"?>
<!-- A translucent white block: reads as a button on every one of the widget's background colours,
     and keeps white text well clear of the contrast minimum on all of them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#33FFFFFF" />
    <stroke android:width="1dp" android:color="#66FFFFFF" />
    <corners android:radius="14dp" />
</shape>
