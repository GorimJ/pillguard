<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/meal_alarm_bg">

    <ImageView
        android:id="@+id/mealGlyph"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_meal_big"
        android:contentDescription="Food" />

    <TextView
        android:id="@+id/mealTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Breakfast"
        android:textColor="@color/white"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/mealSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:text="Time to eat"
        android:textColor="#BBF7D0"
        android:textSize="30sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnEating"
        style="@style/AlarmButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="150dp"
        android:textSize="34sp"
        android:text="OK, I am eating now" />

    <Button
        android:id="@+id/btnLater"
        style="@style/AlarmButtonAlt.Meal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:textSize="24sp"
        android:text="Remind me later" />
</LinearLayout>
