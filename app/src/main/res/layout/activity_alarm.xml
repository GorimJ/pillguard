<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@color/alarm_bg">

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Time for your medication"
        android:textColor="@color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/alarmTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="07:00"
        android:textColor="#FFD166"
        android:textSize="64sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/alarmSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"
        android:text="Scan the QR code on the bottom of the pill container to stop the alarm."
        android:textColor="#CBD5E1"
        android:textSize="20sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnScan"
        style="@style/BigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="96dp"
        android:textSize="26sp"
        android:text="@string/scan_qr" />

    <Button
        android:id="@+id/btnSnooze"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="72dp"
        android:textSize="22sp"
        android:textAllCaps="false"
        android:text="Snooze 5 min" />

    <Button
        android:id="@+id/btnOverride"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:text="@string/carer_override" />
</LinearLayout>
