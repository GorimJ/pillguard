<resources>
    <style name="Theme.PillGuard" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Theme.PillGuard.WithBar" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <style name="Theme.PillGuard.Alarm" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="android:windowBackground">@color/alarm_bg</item>
        <item name="android:statusBarColor">@color/alarm_bg</item>
    </style>

    <style name="BigButton" parent="Widget.Material3.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
    </style>
</resources>
