<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/pill_alarm_bg">

    <ImageView
        android:id="@+id/alarmGlyph"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_pill_big"
        android:contentDescription="Pills" />

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PILLS"
        android:textColor="@color/white"
        android:textSize="60sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/alarmTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="07:00"
        android:textColor="#FFD166"
        android:textSize="72sp"
        android:textStyle="bold"
        android:gravity="center" />

    <Button
        android:id="@+id/btnGoing"
        style="@style/AlarmButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="150dp"
        android:textSize="40sp"
        android:text="GET PILL" />

    <Button
        android:id="@+id/btnTaking"
        style="@style/AlarmButtonAlt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:textSize="32sp"
        android:text="SCAN — taking it" />

    <Button
        android:id="@+id/btnOverride"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textColor="@color/hint_on_dark"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:text="@string/carer_override" />
</LinearLayout>
