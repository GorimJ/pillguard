<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/alarm_bg">

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go and get your pills"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/alarmTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="07:00"
        android:textColor="#FFD166"
        android:textSize="56sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/alarmSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="28dp"
        android:text="The alarm will keep coming back every 2 minutes until you scan the code on the pill container."
        android:textColor="#CBD5E1"
        android:textSize="18sp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnGoing"
        style="@style/BigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:textSize="28sp"
        android:backgroundTint="#FFD166"
        android:textColor="@color/black"
        android:text="I'm going to get the pill" />

    <Button
        android:id="@+id/btnTaking"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="84dp"
        android:textSize="22sp"
        android:textAllCaps="false"
        android:text="I'm taking it now — scan the container" />

    <Button
        android:id="@+id/btnOverride"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:textColor="#94A3B8"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:text="@string/carer_override" />
</LinearLayout>
