<?xml version="1.0" encoding="utf-8"?>
<!-- Same language as the alarm screens: little text, large type, big targets. No ScrollView —
     everything has to be on the screen at once; a list that scrolls is a list he will not read. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/outRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/out_bg"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Only the "you are out" state has a heading; the question screen lets the buttons ask. -->
    <TextView
        android:id="@+id/outTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You are out"
        android:textColor="@color/white"
        android:textSize="42sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/outUntil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Alarms back at 16:05"
        android:textColor="#FFD166"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/outDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:layout_marginBottom="6dp"
        android:text=""
        android:textColor="@color/white"
        android:textSize="24sp"
        android:lineSpacingMultiplier="1.1"
        android:gravity="center" />

    <Button
        android:id="@+id/btnOutYes"
        style="@style/AlarmButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:minHeight="120dp"
        android:textSize="34sp"
        android:text="Going out for 2 hours" />

    <!-- Two hours is not always enough, and guessing wrong is the thing that makes him anxious. -->
    <Button
        android:id="@+id/btnOutLonger"
        style="@style/AlarmButtonAlt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="88dp"
        android:textSize="28sp"
        android:text="Longer — 3 hours" />

    <Button
        android:id="@+id/btnOutNo"
        style="@style/AlarmButtonAlt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:textSize="26sp"
        android:text="Cancel" />
</LinearLayout>
