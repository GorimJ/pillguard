<resources>
    <!-- Text/background pairs below are contrast-checked; see contrast notes in the README.
         Targets are well above the WCAG minimum because the user has poor eyesight. -->
    <color name="brand">#1E5AA8</color>
    <color name="brand_dark">#143F78</color>
    <color name="ok_green">#0E5C27</color>        <!-- 7.1:1 on ok_green_bg -->
    <color name="ok_green_bg">#DDF5E3</color>
    <color name="no_red">#7A1710</color>          <!-- 8.4:1 on no_red_bg, 10.7:1 on white -->
    <color name="no_red_bg">#FBDDDB</color>
    <color name="warn_amber">#6F4200</color>      <!-- 7.4:1 on warn_amber_bg -->
    <color name="warn_amber_bg">#FFECC7</color>
    <color name="alarm_bg">#0F172A</color>
    <!-- One colour per alarm type, so he knows which alarm it is before reading anything.
         Paired with a different glyph on each screen for red-green colour deficiency. -->
    <color name="pill_alarm_bg">#0B3A8C</color>
    <color name="meal_alarm_bg">#126B33</color>
    <!-- Night pills: a different container, so a violet screen rather than the daytime blue.
         White 10.6:1, amber #FFD166 7.4:1, hint #CBD5E1 7.2:1 — all above the daytime floor. -->
    <color name="night_alarm_bg">#5B1E86</color>
    <!-- "Going out": slate, distinct from all three alarm screens.
         White 11.5:1, amber #FFD166 8.0:1, and slate-on-white for the second button 11.5:1. -->
    <color name="out_bg">#1F3A5F</color>
    <color name="out_text">#1F3A5F</color>
    <!-- "I'm going out" on the main screen: white on this red is 8.9:1. -->
    <color name="out_btn_red">#8F1D16</color>
    <!-- Solid widget blocks: white text sits on these (8.4:1, 8.9:1, 8.6:1). -->
    <color name="widget_green">#0F5A25</color>
    <color name="widget_red">#8F1D16</color>
    <color name="widget_amber">#6F4200</color>

    <!-- Alarm buttons: fixed colours, not theme-derived, so nothing can override them.
         Primary  black on amber  14.6:1
         Alt      navy/green on white  10.5:1 / 8.4:1
         Hint     #CBD5E1 on blue  7.1:1 -->
    <color name="btn_primary_bg">#FFD166</color>
    <color name="btn_primary_text">#000000</color>
    <color name="btn_alt_bg">#FFFFFF</color>
    <color name="btn_alt_text_pill">#0B3A8C</color>
    <color name="btn_alt_text_meal">#0E5A2B</color>
    <!-- Scan button on the night screen: violet on white, 10.6:1. -->
    <color name="btn_alt_text_night">#5B1E86</color>
    <color name="hint_on_dark">#CBD5E1</color>
    <!-- "Waiting" state for the Get pill button: reads as inactive against the blue (1.4:1) while
         its countdown stays legible (white at 7.5:1). -->
    <color name="btn_waiting_bg">#4A5568</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <!-- Overrides zxing: fully opaque outside the scan window so only the window is "live". -->
    <color name="zxing_viewfinder_mask">#FF000000</color>
    <color name="zxing_viewfinder_laser">#FFFFD166</color>
</resources>
