<?xml version="1.0" encoding="utf-8"?>
<!-- The two buttons are weighted (3:2) rather than fixed-height, so they always fill whatever
     space is left after the header and stay in proportion on any screen size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="@color/pill_alarm_bg">

    <ImageView
        android:id="@+id/alarmGlyph"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_pill_big"
        android:contentDescription="Pills" />

    <TextView
        android:id="@+id/alarmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PILLS"
        android:textColor="@color/white"
        android:textSize="54sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:gravity="center" />

    <TextView
        android:id="@+id/alarmTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="07:00"
        android:textColor="#FFD166"
        android:textSize="66sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:gravity="center" />

    <Button
        android:id="@+id/btnGoing"
        style="@style/AlarmButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:textSize="52sp"
        android:text="GET PILL" />

    <Button
        android:id="@+id/btnTaking"
        style="@style/AlarmButtonAlt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:textSize="46sp"
        android:text="SCAN" />

    <Button
        android:id="@+id/btnOverride"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/hint_on_dark"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:text="@string/carer_override" />
</LinearLayout>
