<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the library's capture layout: big scan window, everything else opaque black. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_framing_rect_width="320dp"
        app:zxing_framing_rect_height="320dp"
        app:zxing_scanner_layout="@layout/zxing_scanner_big" />
</merge>
